# Local PostgreSQL via pgAdmin
# 1. In pgAdmin: create database "customer_iq"
# 2. Replace YOUR_PASSWORD with your postgres user password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/customer_iq?schema=public"

PORT=5000
JWT_SECRET=change_me_in_production

